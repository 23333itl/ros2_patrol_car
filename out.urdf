    <child link="right_wheel_link"/>
    <origin xyz="0 -0.10 -0.06"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="right_wheel_link">
    <!-- 橡胶轮/地面摩擦约 1.0 即可；20.0 会让 ODE 接触求解器过刚，
                 容易出现轮子抖动或整车弹跳。kp 也从 1e9 降到 1e6。 -->
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
    <kp value="1000000.0"/>
    <kd value="100.0"/>
  </gazebo>
  <link name="front_caster_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
