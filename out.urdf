    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.032"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 0.5"/>
      </material>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="3.8933333333333336e-05" ixy="0" ixz="0" iyy="3.8933333333333336e-05" iyz="0" izz="5.1200000000000004e-05"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.10 -0.06"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="left_wheel_link">
    <!-- 橡胶轮/地面摩擦约 1.0 即可；20.0 会让 ODE 接触求解器过刚，
                 容易出现轮子抖动或整车弹跳。kp 也从 1e9 降到 1e6。 -->
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
    <kp value="1000000.0"/>
    <kd value="100.0"/>
  </gazebo>
  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 0 0"/>
