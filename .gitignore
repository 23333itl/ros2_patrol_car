# ==========================================
# ROS 2 编译与运行目录（必须忽略）
# ==========================================
build/
install/
log/

# ==========================================
# 运行产物：日志 / 建图输出 / 诊断数据
# ==========================================
# 仿真与节点日志：launch.log、launch_2.log、launch_test.log、launch_new.log …
*.log
# 探索节点在仓库根目录落盘的地图与状态：explored_maze.* / explorer_maze.*
/explored_maze.*
/explorer_maze.*
# 自己另存的巡逻地图
/maps/
# 生成器输出的世界与地图（可用 maze_generator 重新生成）
maze_output/
# 原始 ROS/Gazebo 验证数据（报告保存在 src/maze_explorer/docs）
diagnostics/
# rosbag2 录制
*.bag
*.db3
*.mcap
rosbag2_*/

# ==========================================
# 生成文件（可由 xacro / tf2_tools 重新生成）
# ==========================================
/out.urdf
/src/out.urdf
/frames_*.gv
/frames_*.pdf

# ==========================================
# 根目录的截图 / 临时图片
# （bot_description/media 下的材质贴图不受影响）
# ==========================================
/*.png
/*.jpg
/*.jpeg

# ==========================================
# Python 缓存文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# ==========================================
# C/C++ 编译中间文件（即使不在 build 里也防止误传）
# ==========================================
*.o
*.so
*.a
*.out
compile_commands.json
.ccache/

# ==========================================
# 编辑器与系统杂项文件
# ==========================================
# VS Code 配置（含 .vscode/browse.vc.db 这类上百 MB 的 IntelliSense 数据库）
.vscode/
.idea/
# Vim 临时文件
*.swp
*~
# Mac / Windows 系统文件
.DS_Store
Thumbs.db

# ==========================================
# 压缩包与备份文件
# ==========================================
*.tar
*.tar.gz
*.zip
*.orig
*.rej
