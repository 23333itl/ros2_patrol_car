# ==========================================
# ROS 2 核心编译与日志目录 (必须忽略)
# ==========================================
build/
install/
log/

# ==========================================
# 根据你截图定制的特定文件
# ==========================================
# 运行产生的日志和输出文件夹 (如果不包含必须的源码或静态地图，建议忽略)
launch_full.log
maze_output/

# ==========================================
# Python 缓存文件 (因为ROS2常用Python写节点)
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# C/C++ 编译中间文件 (即使不在build里，也防止误传)
# ==========================================
*.o
*.so
*.a
*.out

# ==========================================
# 编辑器与系统杂项文件
# ==========================================
# VS Code 配置 (如果你有团队共享的配置，可以去掉这行)
.vscode/
# Vim 临时文件
*.swp
*~
# Mac 系统文件 (如果你有时会把硬盘插到Mac上)
.DS_Store
# Windows 系统文件
Thumbs.db

# ==========================================
# 压缩包与备份文件 (防止把巨大的备份传上去)
# ==========================================
*.tar
*.tar.gz
*.zip

# 原始 ROS/Gazebo 验证数据（报告保存在源码 docs）
diagnostics/
