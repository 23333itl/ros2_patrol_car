<?xml version="1.0"?>
<!---"前后轮"-->
<robot xmlns:xacro ="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find bot_description)/bot/common_inertial.xacro"/>
    <xacro:macro name="caster_xacro" params="caster_name xyz">
        <link name="${caster_name}_caster_link">
            <visual>    
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.016"/> 
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.016"/> 
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </collision>
            <xacro:sphere_inertia m="0.01" r="0.016" />
        </link>
    <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${caster_name}_caster_link"/>
            <origin xyz="${xyz}"/>
    </joint>
    <!-- 万向球只承担支撑：它们是 fixed 关节、只能横滑，
         摩擦必须接近零，否则差速原地转向时两个球的滑动阻力
         会抵消电机扭矩，车在转角就转不动（卡住）。
         0.2 -> 0.01，让原地旋转顺畅。 -->
    <gazebo reference="${caster_name}_caster_link">
        <mu1 value="0.01"/>
        <mu2 value="0.01"/>
        <kp value="1000000.0"/>
        <kd value="10.0"/>
    </gazebo>
    </xacro:macro>
</robot>
