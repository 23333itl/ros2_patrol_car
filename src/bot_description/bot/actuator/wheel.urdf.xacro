<?xml version="1.0"?>
<robot xmlns:xacro ="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find bot_description)/bot/common_inertial.xacro"/>
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">   
        <link name="${wheel_name}_wheel_link">
            <visual>    
                <origin xyz="0 0 0" rpy="1.57 0 0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57 0 0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </collision>
            <xacro:cylinder_inertia  m="0.1" r="0.032" h="0.04"/>
        </link>
    <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_wheel_link"/>
            <origin xyz="${xyz}"/>
            <axis xyz="0 1 0"/>         
    </joint>
    <gazebo reference="${wheel_name}_wheel_link">
            <!-- 橡胶轮/地面摩擦约 1.0 即可；20.0 会让 ODE 接触求解器过刚，
                 容易出现轮子抖动或整车弹跳。kp 也从 1e9 降到 1e6。 -->
            <mu1 value="1.2" />
            <mu2 value="1.2" />
            <kp value="1000000.0" />
            <kd value="100.0" />
    </gazebo>
    </xacro:macro>
</robot>
