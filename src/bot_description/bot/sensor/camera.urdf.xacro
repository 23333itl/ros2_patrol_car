<?xml version="1.0"?>
<robot xmlns:xacro ="http://www.ros.org/wiki/xacro">
    <xacro:macro name="camera_xacro" params="xyz">
    <xacro:include filename="$(find bot_description)/bot/common_inertial.xacro"/>
        <link name="camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.1 0.02" />
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.1 0.02" />
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </collision>
            <xacro:box_inertia  m="0.2" w="0.02" h="0.1" d="0.02"/>
        </link>
        <joint name="camera_joint" type="fixed">
            <parent link="base_link"/>
            <child link="camera_link"/>
            <origin xyz="${xyz}"/>
        </joint>
    </xacro:macro>
</robot>
