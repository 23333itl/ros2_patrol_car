<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_sensor_plugin">

        <!-- 激光雷达：默认 gpu_lidar。Gazebo Sim 8 不支持 CPU ray/lidar，
             切回 ray 会导致 /scan 缺失并使 AMCL 无法发布 map -> odom。
             10 Hz / 360 线足够 slam_toolbox 在迷宫里稳定匹配。 -->
        <gazebo reference="laser_link">
            <sensor name="lidar" type="$(arg lidar_type)">
                <always_on>true</always_on>
                <visualize>false</visualize>
                <update_rate>10</update_rate>
                <topic>scan</topic>
                <gz_frame_id>laser_link</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1.000000</resolution>
                            <min_angle>-3.141593</min_angle>
                            <max_angle>3.141593</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.120000</min>
                        <max>8.0</max>
                        <resolution>0.015000</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
         <!-- IMU：Gazebo Sim imu -->
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <topic>/imu</topic>
                <gz_frame_id>imu_link</gz_frame_id>
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
        
        <!-- 深度相机：默认关闭（当前导航/SLAM 链路不使用相机）。
             需要时 launch 传 camera:=true；分辨率降到 640x480@5Hz，
             减少 rgbd + point cloud 的渲染和桥接开销。 -->
        <xacro:if value="$(arg enable_camera)">
            <gazebo reference="camera_link">
                <sensor name="depth_camera" type="rgbd_camera">
                    <always_on>true</always_on>
                    <visualize>false</visualize>
                    <update_rate>5</update_rate>
                    <topic>depth_camera</topic>
                    <gz_frame_id>camera_link</gz_frame_id>
                    <camera>
                        <horizontal_fov>1.5009831567</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.05</near>
                            <far>8.0</far>
                        </clip>
                        <distortion>
                            <k1>0.0</k1>
                            <k2>0.0</k2>
                            <k3>0.0</k3>
                            <p1>0.0</p1>
                            <p2>0.0</p2>
                            <center>0.5 0.5</center>
                        </distortion>
                    </camera>
                </sensor>
            </gazebo>
        </xacro:if>
        
    </xacro:macro>
</robot>
