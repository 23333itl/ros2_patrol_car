<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_control_plugin">
        <gazebo>
            <!-- Gazebo Sim (gz sim) 差速驱动插件 -->
            <!-- 注意：该插件使用 Gazebo 内部话题，需配合 ros_gz_bridge 才能在 ROS2 中使用 -->
            <plugin filename="gz-sim-diff-drive-system"
                    name="gz::sim::systems::DiffDrive">
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>
                <wheel_separation>0.2</wheel_separation>
                <wheel_radius>0.032</wheel_radius>
                <odom_publish_frequency>50</odom_publish_frequency>
                <!-- 插件的 Gazebo TF 不桥接到 ROS；ROS odom TF 由 EKF 唯一发布。 -->
                <frame_id>odom</frame_id>
                <child_frame_id>base_footprint</child_frame_id>
                <!-- Gazebo Sim DiffDrive 支持底盘线/角加速度限幅，与速度平滑器一致。 -->
                <max_linear_velocity>0.15</max_linear_velocity>
                <min_linear_velocity>-0.15</min_linear_velocity>
                <max_angular_velocity>0.30</max_angular_velocity>
                <min_angular_velocity>-0.30</min_angular_velocity>
                <max_linear_acceleration>0.3</max_linear_acceleration>
                <min_linear_acceleration>-0.3</min_linear_acceleration>
                <max_angular_acceleration>0.6</max_angular_acceleration>
                <min_angular_acceleration>-0.6</min_angular_acceleration>
            </plugin>
            <!-- 发布轮子关节状态，robot_state_publisher 需要它才能发轮子 TF -->
            <plugin filename="gz-sim-joint-state-publisher-system"
                    name="gz::sim::systems::JointStatePublisher">
                <topic>/joint_states</topic>
                <update_rate>50</update_rate>
                <joint_name>left_wheel_joint</joint_name>
                <joint_name>right_wheel_joint</joint_name>
            </plugin>
        </gazebo>
   </xacro:macro>
</robot>
